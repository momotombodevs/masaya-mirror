{
  "name": "manolo-mirror",
  "private": true,
  "version": "v0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite.mjs",
    "dev:debug": "node scripts/run-vite.mjs --debug",
    "setup:tools": "node scripts/setup-scrcpy.mjs",
    "postinstall": "node scripts/setup-scrcpy.mjs",
    "build": "pnpm setup:tools && tsc && vite build && electron-builder",
    "build:win": "pnpm setup:tools && tsc && vite build && electron-builder --win nsis --x64",
    "build:win:portable": "pnpm setup:tools && tsc && vite build && electron-builder --win portable --x64",
    "build:mac": "pnpm setup:tools && tsc && vite build && electron-builder --mac dmg --arm64 --x64",
    "build:linux": "pnpm setup:tools && tsc && vite build && electron-builder --linux AppImage --x64",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.0",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@yume-chan/fetch-scrcpy-server": "^1.0.0",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.4"
  },
  "main": "dist-electron/main.js"
}
