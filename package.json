{
  "name": "manolo-mirror",
  "private": true,
  "version": "0.3.0",
  "description": "Android device mirroring and QA workspace for macOS and Windows",
  "author": "Manuel Duarte",
  "license": "UNLICENSED",
  "homepage": "https://github.com/donmanueldev/manolo-mirror",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite.mjs",
    "dev:debug": "node scripts/run-vite.mjs --debug",
    "setup:tools": "node scripts/setup-scrcpy.mjs",
    "postinstall": "node scripts/setup-scrcpy.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:app && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "build:app": "pnpm typecheck && vite build",
    "build": "pnpm build:app && electron-builder",
    "build:mac": "pnpm build:app && electron-builder --mac",
    "build:win": "pnpm build:app && electron-builder --win",
    "build:linux": "pnpm build:app && electron-builder --linux",
    "preview": "vite preview"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.0",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@yume-chan/fetch-scrcpy-server": "^1.0.0",
    "autoprefixer": "^10.6.1",
    "electron": "^42.11.15",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "3.4.17",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.4"
  },
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  }
}
