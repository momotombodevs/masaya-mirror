// Packaging for macOS and Windows (plus a Linux AppImage). Reference:
// https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.manolo.mirror',
  productName: 'Manolo Mirror',
  copyright: 'Copyright © 2026 Manolo Mirror',
  asar: true,
  directories: {
    output: 'release/${version}',
    // build/icon.png (1024×1024) is converted to .icns and .ico automatically.
    buildResources: 'build',
  },
  files: ['dist', 'dist-electron'],
  extraResources: [
    {
      from: 'resources/scrcpy-server',
      to: 'scrcpy-server',
      filter: ['**/*'],
    },
  ],
  // One name scheme for every platform; the arch keeps the two macOS DMGs from overwriting each other.
  artifactName: '${name}-${version}-${os}-${arch}.${ext}',
  mac: {
    category: 'public.app-category.developer-tools',
    target: [{ target: 'dmg', arch: ['arm64', 'x64'] }],
  },
  win: {
    executableName: 'Manolo Mirror',
    target: [{ target: 'nsis', arch: ['x64'] }],
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: 'Manolo Mirror',
    runAfterFinish: true,
  },
  linux: {
    category: 'Development',
    target: ['AppImage'],
    desktop: {
      Name: 'Manolo Mirror',
      Comment: 'Android device mirroring and QA workspace',
      Categories: 'Development;',
    },
  },
}
