// Packaging for macOS and Windows (plus a Linux AppImage). Reference:
// https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.manolo.mirror',
  productName: 'Manolo Mirror',
  copyright: 'Copyright © 2026 Manolo Mirror',
  asar: true,
  directories: {
    output: 'release/${version}',
    // build/icon.png (1024×1024) is converted to .icns and .ico automatically.
    buildResources: 'build',
  },
  files: ['dist', 'dist-electron'],
  // Hardens the packaged Electron binary. The app never forks itself as Node and loads only from app.asar.
  electronFuses: {
    runAsNode: false,
    enableNodeOptionsEnvironmentVariable: false,
    enableNodeCliInspectArguments: false,
    onlyLoadAppFromAsar: true,
  },
  // Generates app-update.yml and the latest*.yml files electron-updater reads from the GitHub Release.
  // Nothing is uploaded from here: the Release workflow publishes the artifacts.
  publish: [{ provider: 'github', owner: 'donmanueldev', repo: 'manolo-mirror' }],
  extraResources: [
    {
      from: 'resources/scrcpy-server',
      to: 'scrcpy-server',
      filter: ['**/*'],
    },
  ],
  // One name scheme for every platform; the arch keeps the two macOS DMGs from overwriting each other.
  artifactName: '${name}-${version}-${os}-${arch}.${ext}',
  mac: {
    category: 'public.app-category.developer-tools',
    // The zip is what Squirrel.Mac installs on update; the dmg is for the first download.
    target: [
      { target: 'dmg', arch: ['arm64', 'x64'] },
      { target: 'zip', arch: ['arm64', 'x64'] },
    ],
    // Required for notarization. Signing only happens when a Developer ID certificate is configured.
    hardenedRuntime: true,
    gatekeeperAssess: false,
    entitlements: 'build/entitlements.mac.plist',
    entitlementsInherit: 'build/entitlements.mac.plist',
    // Notarizes when APPLE_ID, APPLE_APP_SPECIFIC_PASSWORD and APPLE_TEAM_ID are set.
    notarize: true,
  },
  win: {
    executableName: 'Manolo Mirror',
    target: [{ target: 'nsis', arch: ['x64'] }],
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: 'Manolo Mirror',
    runAfterFinish: true,
  },
  linux: {
    category: 'Development',
    // The deb requires a maintainer email; this is GitHub's private noreply address.
    maintainer: 'Manuel Duarte <46093689+donmanueldev@users.noreply.github.com>',
    // AppImage updates itself; the deb is for apt-based systems and is updated by reinstalling.
    target: [
      { target: 'AppImage', arch: ['x64', 'arm64'] },
      { target: 'deb', arch: ['x64', 'arm64'] },
    ],
    desktop: {
      entry: {
        Name: 'Manolo Mirror',
        Comment: 'Android device mirroring and QA workspace',
        Categories: 'Development;',
      },
    },
  },
}
